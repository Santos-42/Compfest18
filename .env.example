# ===== Compfest18 — Smart Logistics & Fraud Detection =====
# Salin file ini menjadi .env lalu isi API key Anda.

# ===== API Eksternal (Wajib untuk mode real) =====
# Daftar di https://opencagedata.com/api
OPENCAGE_API_KEY=
# Daftar di https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ===== DeepSeek (Opsional — penerjemah naratif fraud) =====
# Jika tidak diisi, sistem memakai teks statis.
USE_DEEPSEEK=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Mode Mock / Fallback =====
# true = jangan panggil API eksternal sama sekali (pakai data mock lokal)
USE_MOCK_MODE=false
# true = coba API dulu, lalu fallback ke mock jika gagal
ENABLE_FALLBACK=true

# ===== Konfigurasi Simulasi =====
ORIGIN_LAT=-6.200000
ORIGIN_LNG=106.816666
FRAUD_THRESHOLD=0.7
REQUEST_TIMEOUT=6
